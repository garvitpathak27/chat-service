# ---------------------------------------------------------------------------
# Chat Service configuration. Copy to .env and fill in real values.
# .env is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=S0$VdaDxGz*NRuSxi%6dao^NqAn3W6rDh^e^Rc%SUG7oz^teJD
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,chat-service

# --- Service identity -----------------------------------------------------
SERVICE_NAME=chat-service
SERVICE_PORT=8001

# --- Chat MySQL -----------------------------------------------------------
DB_NAME=chat_db
DB_USER=chat_user
DB_PASSWORD=chat@123
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Auth Service gRPC ----------------------------------------------------
AUTH_GRPC_HOST=localhost
AUTH_GRPC_PORT=50051
AUTH_GRPC_TIMEOUT_SECONDS=2.0
AUTH_GRPC_MAX_RETRIES=2

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=chat.events

# --- Eureka ---------------------------------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_APP_NAME=chat-service
EUREKA_INSTANCE_HOST=localhost
EUREKA_INSTANCE_PORT=8001
